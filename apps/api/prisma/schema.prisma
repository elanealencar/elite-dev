generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ORGANIZER
  CUSTOMER
  GATE
}

enum ReservationStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  APPROVED
  DECLINED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum TicketValidationResult {
  VALID
  INVALID
  ALREADY_USED
  WRONG_EVENT
}

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role

  events       Event[]
  reservations Reservation[]

  ticketValidations TicketValidation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum SeatStatus {
  AVAILABLE
  HELD
  SOLD
}

model Event {
  id             String      @id @default(uuid())
  tmdbMovieId    Int
  movieTitle     String
  moviePosterUrl String?
  dateTime       DateTime
  location       String
  room           String
  price          Decimal     @db.Decimal(10, 2)
  capacity       Int         @default(48)
  status         EventStatus @default(DRAFT)

  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id])

  seats        EventSeat[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventSeat {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  row       String
  number    Int
  status    SeatStatus @default(AVAILABLE)
  heldUntil DateTime?

  reservationSeats ReservationSeat[]

  createdAt DateTime @default(now())

  @@unique([eventId, row, number])
}

model Reservation {
  id String @id @default(uuid())

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  status      ReservationStatus @default(PENDING_PAYMENT)
  expiresAt   DateTime
  totalAmount Decimal           @db.Decimal(10, 2)

  seats ReservationSeat[]
  payment Payment?
  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReservationSeat {
  id String @id @default(uuid())

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  eventSeatId String
  eventSeat   EventSeat @relation(fields: [eventSeatId], references: [id])

  price Decimal @db.Decimal(10, 2)
  
  ticket Ticket?

  createdAt DateTime @default(now())

  @@unique([reservationId, eventSeatId])
}

model Payment {
  id            String        @id @default(uuid())

  reservationId String        @unique
  reservation   Reservation   @relation(fields: [reservationId], references: [id])

  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus

  createdAt     DateTime      @default(now())
}

model Ticket {
  id                String       @id @default(uuid())

  reservationId     String
  reservation       Reservation  @relation(fields: [reservationId], references: [id])

  reservationSeatId String       @unique
  reservationSeat   ReservationSeat @relation(fields: [reservationSeatId], references: [id])

  code              String       @unique
  shareToken        String       @unique

  status            TicketStatus @default(VALID)
  usedAt            DateTime?

  validations       TicketValidation[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model TicketValidation {
  id         String                 @id @default(uuid())

  ticketId   String?
  ticket     Ticket?                @relation(fields: [ticketId], references: [id])

  eventId    String

  gateUserId String
  gateUser   User                   @relation(fields: [gateUserId], references: [id])

  result     TicketValidationResult

  createdAt  DateTime               @default(now())
}