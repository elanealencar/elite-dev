generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ORGANIZER
  CUSTOMER
  GATE
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  events       Event[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum SeatStatus {
  AVAILABLE
  HELD
  SOLD
}

model Event {
  id              String      @id @default(uuid())
  tmdbMovieId     Int
  movieTitle      String
  moviePosterUrl  String?
  dateTime        DateTime
  location        String
  room            String
  price           Decimal     @db.Decimal(10, 2)
  capacity        Int         @default(48)
  status          EventStatus @default(DRAFT)

  organizerId     String
  organizer       User        @relation(fields: [organizerId], references: [id])

  seats           EventSeat[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model EventSeat {
  id        String     @id @default(uuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  row       String
  number    Int
  status    SeatStatus @default(AVAILABLE)
  heldUntil DateTime?

  createdAt DateTime   @default(now())

  @@unique([eventId, row, number])
}